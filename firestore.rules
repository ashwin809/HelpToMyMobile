rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function notBlockedBetween(firstUserId, secondUserId) {
      return !exists(/databases/$(database)/documents/users/$(firstUserId)/blockedUsers/$(secondUserId))
        && !exists(/databases/$(database)/documents/users/$(secondUserId)/blockedUsers/$(firstUserId));
    }

    function threadParticipants(threadId) {
      return get(/databases/$(database)/documents/chatThreads/$(threadId)).data.participants;
    }

    function canAccessThread(threadId) {
      let participants = threadParticipants(threadId);
      let otherUserId = participants[0] == request.auth.uid ? participants[1] : participants[0];
      return signedIn()
        && participants is list
        && participants.size() == 2
        && participants.hasAny([request.auth.uid])
        && notBlockedBetween(request.auth.uid, otherUserId);
    }

    function authoredByCurrentMember(userId, name, role, university, designation) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn()
        && request.auth.uid == userId
        && name == profile.firstName + ' ' + profile.lastName
        && role == profile.userType
        && university == profile.get('university', '')
        && designation == profile.get('designation', '');
    }

    match /users/{userId} {
      // This document contains private contact and address fields. Public discovery
      // must use a separate, explicitly curated profile document.
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.isVerified == request.auth.token.email_verified;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'firstName', 'lastName', 'university',
          'department', 'designation', 'educationLevel', 'skills', 'bio', 'avatarUrl',
          'address1', 'address2', 'city', 'state', 'country', 'postCode', 'phone', 'mobile'
        ]);
      allow delete: if false;

      match /pushTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /blockedUsers/{targetUserId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && targetUserId != userId
          && request.resource.data.targetUserId is string
          && request.resource.data.targetUserId != userId;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /helpRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'university', 'department',
          'authorId', 'authorName', 'authorRole', 'authorUniversity', 'authorDesignation',
          'urgency', 'status', 'createdAt', 'responseCount', 'upvotes', 'tags'
        ])
        && request.resource.data.keys().hasAll([
          'title', 'description', 'category', 'university', 'department',
          'authorId', 'authorName', 'authorRole', 'authorUniversity', 'authorDesignation',
          'urgency', 'status', 'createdAt', 'responseCount', 'upvotes', 'tags'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 5000
        && request.resource.data.category in [
          'Admissions', 'Research', 'Syllabus & Exam', 'Scholarships', 'Career Guidance', 'General Help'
        ]
        && request.resource.data.university is string
        && request.resource.data.university.size() > 0
        && request.resource.data.university.size() <= 160
        && request.resource.data.department is string
        && request.resource.data.urgency in ['Low', 'Medium', 'High']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.responseCount == 0
        && request.resource.data.upvotes == 0
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 10
        && authoredByCurrentMember(
          request.resource.data.authorId,
          request.resource.data.authorName,
          request.resource.data.authorRole,
          request.resource.data.authorUniversity,
          request.resource.data.authorDesignation
        );
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'resolved';
      allow delete: if false;

      match /responses/{responseId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/helpRequests/$(requestId))
          && notBlockedBetween(
            request.auth.uid,
            get(/databases/$(database)/documents/helpRequests/$(requestId)).data.authorId
          )
          && request.resource.data.keys().hasOnly([
            'requestId', 'authorId', 'authorName', 'authorRole',
            'authorUniversity', 'authorDesignation', 'content', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'requestId', 'authorId', 'authorName', 'authorRole',
            'authorUniversity', 'authorDesignation', 'content', 'createdAt'
          ])
          && request.resource.data.requestId == requestId
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 5000
          && request.resource.data.createdAt == request.time
          && authoredByCurrentMember(
            request.resource.data.authorId,
            request.resource.data.authorName,
            request.resource.data.authorRole,
            request.resource.data.authorUniversity,
            request.resource.data.authorDesignation
          );
        allow update, delete: if false;
      }

      match /upvotes/{userId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create: if signedIn()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/helpRequests/$(requestId))
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    match /chatThreads/{threadId} {
      allow read: if signedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && notBlockedBetween(request.resource.data.participants[0], request.resource.data.participants[1]);
      allow update: if signedIn()
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants == resource.data.participants
        && notBlockedBetween(resource.data.participants[0], resource.data.participants[1]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canAccessThread(threadId);
        allow create: if canAccessThread(threadId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.threadId == threadId
          && request.resource.data.text is string;
        allow update: if canAccessThread(threadId)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead == true;
      allow create, delete: if false;
    }
  }
}
