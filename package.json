{
  "name": "helptoyou",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "setup": "npm ci && npm --prefix server ci",
    "deps:check": "expo install --check",
    "start": "expo start --web",
    "start:native": "expo start",
    "start:native:clear": "expo start --clear",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ts:check": "tsc --noEmit",
    "api:dev": "npm --prefix server run dev",
    "server": "npm --prefix server run dev",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.7.9",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "fast-glob": "^3.3.3",
    "find-up": "^8.0.0",
    "fs-extra": "^11.4.1",
    "@ungap/structured-clone": "^1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "expo-modules-autolinking": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
