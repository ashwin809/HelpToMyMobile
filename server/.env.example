# Node API
PORT=4000
DATABASE_URL=postgresql://postgres:helptoyou-local-only@localhost:5432/helptoyou
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
APP_PUBLIC_URL=http://localhost:8081

# LLM-backed academic assistant. Keep this API key on the server only.
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/responses
LLM_MODEL=openai/gpt-oss-20b

# Gmail / Google Workspace SMTP. Use a Google app password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HelpToYou <your-gmail-address@gmail.com>

# Google Calendar: web OAuth client configured in Google Cloud Console.
# The callback URL must exactly match an authorized redirect URI and be publicly reachable over HTTPS.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-api-domain.example/api/v1/calendar/google/callback
# Generate once with: openssl rand -hex 32. Keep this stable to decrypt stored refresh tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=
