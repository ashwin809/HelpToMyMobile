{
  "expo": {
    "name": "HelpToYou",
    "slug": "helptoyou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00BD62"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.helptoyou.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00BD62"
      },
      "package": "org.helptoyou.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      "expo-notifications"
    ]
  }
}
